                "key": {
                  "kind": "concat",
                  "parts": [
                    {
                      "kind": "caller"
                    },
                    {
                      "kind": "lit",
                      "value": "/"
                    },
                    {
                      "kind": "input",
                      "name": "photoId",
                      "source": "params"
                    }
                  ]
                },
                "op": "downloadUrl"
              },
              "var": 1
