                    "of": {
                      "id": 0,
                      "kind": "var"
                    }
                  }
                },
                "kind": "not"
              },
              "error": "missing",
              "kind": "ensure"
            },
            {
              "kind": "let",
              "op": {
                "bucket": "photos",
