        "plan": {
          "body": [
            {
              "kind": "let",
              "op": {
                "bucket": "photos",
                "key": {
                  "kind": "concat",
                  "parts": [
                    {
                      "kind": "caller"
                    },
                    {
                      "kind": "lit",
                      "value": "/"
                    },
                    {
                      "kind": "input",
                      "name": "photoId",
                      "source": "params"
                    }
                  ]
