          },
          "size": {
            "type": {
              "kind": "int",
              "max": 5242880,
              "min": 0
            }
          },
          "uploadedAt": {
            "type": {
              "kind": "timestamp"
            }
          }
        },
        "indexes": {},
        "key": ["key"]
      }
