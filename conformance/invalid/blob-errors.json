            {
              "kind": "let",
              "op": {
                "entity": "Photo",
                "key": {
                  "key": {
                    "kind": "concat",
                    "parts": [
                      {
                        "kind": "caller"
                      },
                      {
                        "kind": "lit",
                        "value": "/"
                      },
                      {
                        "kind": "input",
                        "name": "photoId",
                        "source": "params"
                      }
                    ]
                  }
                },
                "op": "delete"
              },
              "var": 1
            }
          ],
          "output": {
            "fields": {
              "deleted": {
                "kind": "concat",
                "parts": [
                  {
                    "kind": "caller"
                  },
                  {
                    "kind": "lit",
                    "value": "/"
                  },
                  {
                    "kind": "input",
                    "name": "photoId",
                    "source": "params"
                  }
                ]
              }
            },
            "kind": "object"
          }
