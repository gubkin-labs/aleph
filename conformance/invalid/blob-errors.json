          ],
          "output": {
            "fields": {
              "download": {
                "id": 1,
                "kind": "var"
              },
              "file": {
                "id": 0,
                "kind": "var"
              }
            },
            "kind": "object"
          }
        }
      },
      {
        "auth": {
          "kind": "signedIn"
        },
        "errors": {},
        "id": "delete_photo",
        "input": {
          "body": {},
          "params": {
            "photoId": {
              "type": {
                "kind": "string",
                "max": 64,
                "min": 0
              }
            }
          },
          "query": {}
        },
