{
  "seed": 7,
  "startMs": 1700000000000,
  "stepMs": 1000,
  "steps": [
    {
      "name": "billing needs a caller",
      "request": {
        "method": "PUT",
        "path": "/orgs/acme/billing",
        "body": {
          "plan": "free"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "error": "unauthorized"
        }
      }
    },
    {
      "name": "only owners set the plan",
      "request": {
        "method": "PUT",
        "path": "/orgs/acme/billing",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        },
        "body": {
          "plan": "pro"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "create the first project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "Alpha"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "orgId": "acme",
          "name": "Alpha",
          "status": "active"
        }
      },
      "capture": {
        "alpha": "body.projectId"
      }
    },
    {
      "name": "create a second project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "Beta"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "beta": "body.projectId"
      }
    },
    {
      "name": "create a third project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "Gamma"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "the free plan stops at three active projects",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "Delta"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "planLimit",
          "message": "Your plan's project limit is reached"
        }
      }
    },
    {
      "name": "upgrade to pro (upsert)",
      "request": {
        "method": "PUT",
        "path": "/orgs/acme/billing",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "plan": "pro"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "orgId": "acme",
          "plan": "pro"
        }
      }
    },
    {
      "name": "pro allows a fourth project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "Delta"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "members can't create projects",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        },
        "body": {
          "name": "Nope"
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "non-members can't list",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u3",
          "orgs": {
            "other": "owner"
          }
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "members list active projects, newest first",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "name": "Delta"
            },
            {
              "name": "Gamma"
            },
            {
              "name": "Beta"
            },
            {
              "name": "Alpha"
            }
          ],
          "cursor": null
        }
      }
    },
    {
      "name": "an API key with the read scope can list",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "apiKey": {
            "orgId": "acme",
            "scopes": ["projects:read"]
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [{}, {}, {}, {}]
        }
      }
    },
    {
      "name": "an API key without the scope can't",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "apiKey": {
            "orgId": "acme",
            "scopes": []
          }
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "error": "forbidden"
        }
      }
    },
    {
      "name": "page 1",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "limit": "2"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "name": "Delta"
            },
            {
              "name": "Gamma"
            }
          ]
        }
      },
      "capture": {
        "page2": "body.cursor"
      }
    },
    {
      "name": "page 2 continues after the cursor",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "limit": "2",
          "cursor": "{{page2}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "name": "Beta"
            },
            {
              "name": "Alpha"
            }
          ]
        }
      },
      "capture": {
        "page3": "body.cursor"
      }
    },
    {
      "name": "page 3 is empty and has no cursor",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "limit": "2",
          "cursor": "{{page3}}"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [],
          "cursor": null
        }
      }
    },
    {
      "name": "a forged cursor is rejected",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "cursor": "ff00"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "invalid_input",
          "message": "invalid cursor"
        }
      }
    },
    {
      "name": "archive a project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{alpha}}/archive",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "name": "Alpha",
          "status": "archived"
        }
      }
    },
    {
      "name": "archived projects are listed separately",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "status": "archived"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "items": [
            {
              "name": "Alpha"
            }
          ]
        }
      }
    },
    {
      "name": "a limit over the declared max is rejected before the plan runs",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "query": {
          "limit": "500"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "invalid_input",
          "details": [
            {
              "field": "query.limit"
            }
          ]
        }
      }
    },
    {
      "name": "archived projects take no tasks",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{alpha}}/tasks",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "title": "Too late"
        }
      },
      "expect": {
        "status": 409,
        "body": {
          "error": "archived"
        }
      }
    },
    {
      "name": "members add tasks",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/tasks",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        },
        "body": {
          "title": "Write spec"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "t1": "body.taskId"
      }
    },
    {
      "name": "add another task",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/tasks",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "title": "Build core"
        }
      },
      "expect": {
        "status": 200
      },
      "capture": {
        "t2": "body.taskId"
      }
    },
    {
      "name": "add a third task",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/tasks",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "title": "Ship"
        }
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "bulk-complete skips ids that don't exist",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/tasks/complete",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "taskIds": ["{{t1}}", "{{t2}}", "{{alpha}}"]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "completed": 2,
          "stillOpen": 1
        }
      }
    },
    {
      "name": "completing again is a no-op",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/tasks/complete",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "taskIds": ["{{t1}}"]
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "completed": 0,
          "stillOpen": 1
        }
      }
    },
    {
      "name": "read a project with its tasks, counters, and the caller's role",
      "request": {
        "method": "GET",
        "path": "/orgs/acme/projects/{{beta}}",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "project": {
            "name": "Beta"
          },
          "openTasks": 1,
          "summary": "Beta (active)",
          "myRole": "member",
          "tasks": [
            {
              "title": "Write spec",
              "done": true
            },
            {
              "title": "Build core",
              "done": true
            },
            {
              "title": "Ship",
              "done": false
            }
          ]
        }
      }
    },
    {
      "name": "watch a project",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/watch",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "added": true
        }
      }
    },
    {
      "name": "watching again inserts nothing",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/{{beta}}/watch",
        "caller": {
          "userId": "u2",
          "orgs": {
            "acme": "member"
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "added": false
        }
      }
    },
    {
      "name": "a missing project is a declared 404",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/01ARZ3NDEKTSV4RRFFQ69G5FAV/archive",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "notFound",
          "message": "Project not found"
        }
      }
    },
    {
      "name": "a malformed id is rejected as input",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects/nope/archive",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "invalid_input"
        }
      }
    },
    {
      "name": "unknown body fields are rejected",
      "request": {
        "method": "POST",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        },
        "body": {
          "name": "X",
          "color": "red"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "details": [
            {
              "field": "body.color",
              "message": "unknown field"
            }
          ]
        }
      }
    },
    {
      "name": "unknown routes are 404",
      "request": {
        "method": "GET",
        "path": "/nope",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        }
      },
      "expect": {
        "status": 404,
        "body": {
          "error": "route_not_found"
        }
      }
    },
    {
      "name": "wrong methods are 405",
      "request": {
        "method": "DELETE",
        "path": "/orgs/acme/projects",
        "caller": {
          "userId": "u1",
          "orgs": {
            "acme": "owner"
          }
        }
      },
      "expect": {
        "status": 405,
        "body": {
          "error": "method_not_allowed"
        }
      }
    }
  ]
}
