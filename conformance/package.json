{
  "name": "@aleph/conformance",
  "private": true,
  "description": "Golden manifests and scenarios that every Aleph SDK and platform must agree on",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update": "UPDATE_GOLDEN=1 vitest run"
  },
  "devDependencies": {
    "@aleph/core": "workspace:*",
    "@aleph/manifest": "workspace:*",
    "@aleph/sdk": "workspace:*"
  }
}
